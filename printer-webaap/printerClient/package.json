{
  "name": "node-printer-setup",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run index.ts",
    "daemon": "bun run index.ts --daemon",
    "build": "bun build index.ts --compile --outfile node-printer.exe",
    "build:all": "bun run build:qr && bun run build && bun run release",
    "build:qr": "cargo build --release --manifest-path tauri-qr/src-tauri/Cargo.toml",
    "release": "cp node-printer.exe printerClient-relase && cp tauri-qr/src-tauri/target/release/tauri-qr.exe printerClient-relase/tauri-qr.exe",
    "create:zip": "tar -a -c -f printerClient-relase.zip -C printerClient-relase ."
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}